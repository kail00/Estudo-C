#include <stdio.h>

int main() {

int numero[8];
int menor_par = 0;
int achar_primeiro_numero = 0;

    for(int i = 0; i < 8; i++){
        printf("Digite um número: ");
        scanf("%d", &numero[i]);
    }

    for(int i = 0; i < 8; i++){

        if(numero[i] % 2 == 0){

            if(achar_primeiro_numero == 0){
                menor_par = numero[i];
                achar_primeiro_numero = 1;
            }
            else if(numero[i] < menor_par){
                menor_par = numero[i];
            }

        }
    }

    if(achar_primeiro_numero == 1){
        printf("\nMenor número par: %d\n", menor_par);
    }
    else{
        printf("\nNão existe número par no vetor.\n");
    }

    return 0;
}